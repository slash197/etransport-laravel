{
    "name": "slash197/etransport-laravel",
    "description": "Laravel bridge for slash197/etransport, the PHP client for ANAF's RO e-Transport system",
    "type": "library",
    "license": "MIT",
    "keywords": ["etransport", "e-transport", "ro-e-transport", "anaf", "uit", "romania", "laravel"],
    "homepage": "https://github.com/slash197/etransport-laravel",
    "authors": [
        {
            "name": "Levi Szocs",
            "email": "levi.szocs@codescape.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/http-client": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "slash197/etransport": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "slash197\\eTransport\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "slash197\\eTransport\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "slash197\\eTransport\\Laravel\\ETransportServiceProvider"
            ],
            "aliases": {
                "ETransport": "slash197\\eTransport\\Laravel\\Facades\\ETransport"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
