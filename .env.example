# For the calls against ANAF's test environment. Copy to .env, which is not committed.
# "test" or "production"; the same token works on both
ETRANSPORT_ENVIRONMENT=test
# An ANAF OAuth access token; it is issued for a user with a qualified certificate and is valid for 90 days.
ETRANSPORT_TOKEN=
# The tax code (digits only) that the token's user has e-Transport rights for in SPV
ETRANSPORT_CIF=
